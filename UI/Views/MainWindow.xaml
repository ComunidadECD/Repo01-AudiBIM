<Window x:Class="BIMQualityAuditor.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AudiBIM - Auditoría de Calidad BIM" Height="780" Width="1140"
        WindowStartupLocation="CenterScreen"
        Background="#E2E8F0" Foreground="#0F172A"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Light Grey Button Style with Black Text -->
        <Style TargetType="Button" x:Key="HeaderButtonStyle">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                                <Setter Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style for Deleting -->
        <Style TargetType="Button" x:Key="DangerButtonStyle" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#991B1B"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FCA5A5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FECACA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button Style -->
        <Style TargetType="Button" x:Key="PrimaryAccentButtonStyle" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Revit Action Button Style -->
        <Style TargetType="Button" x:Key="RevitActionButtonStyle" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="Button" x:Key="FilterButtonStyle" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBox" x:Key="EditorTextBoxStyle">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="ComboBox" x:Key="EditorComboBoxStyle">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0. Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Global Summary Banner (when results available) -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Main Content: Tabs -->
            <RowDefinition Height="*"/>
            <!-- 3. Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. HEADER SECTION -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Image x:Name="ImgLogo" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="AudiBIM" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                        <Border Background="#CBD5E1" CornerRadius="4" Margin="10,2,0,2" Padding="8,2">
                            <TextBlock Text="Revit 2025" FontSize="11" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveProjectName, StringFormat='Proyecto: {0}'}" FontSize="13" Foreground="#475569" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#FFFFFF" CornerRadius="8" Padding="14,8" Margin="0,0,12,0" BorderBrush="#CBD5E1" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Reglas en Revisión: " FontSize="13" Foreground="#334155"/>
                        <TextBlock Text="{Binding LoadedRulesCount}" FontSize="16" FontWeight="Bold" Foreground="#2563EB"/>
                    </StackPanel>
                </Border>

                <Button Content="📊 Dashboard de cantidades" Command="{Binding ExportPdfReportCommand}" Style="{StaticResource HeaderButtonStyle}"/>
                <Button Content="📗 Exportar Excel" Command="{Binding ExportExcelReportCommand}" Style="{StaticResource HeaderButtonStyle}"/>
                <Button Content="🔄 Volver a revisar" Command="{Binding RecheckCommand}" Style="{StaticResource HeaderButtonStyle}"/>
                <Button Content="▶️ GENERAR REVISIÓN" Command="{Binding ExecuteRulesCommand}" Style="{StaticResource PrimaryAccentButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- 1. GLOBAL SUMMARY BANNER -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="#2563EB" BorderThickness="1.5"
                Visibility="{Binding HasAuditResults, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Reglas" FontSize="11" Foreground="#64748B" FontWeight="Bold"/>
                        <TextBlock Text="{Binding LoadedRulesCount}" FontSize="18" FontWeight="Bold" Foreground="#2563EB"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Elementos revisados" FontSize="11" Foreground="#64748B" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Summary.TotalElementsEvaluated}" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Cumplen" FontSize="11" Foreground="#166534" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Summary.TotalCompliantElements}" FontSize="18" FontWeight="Bold" Foreground="#16A34A"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Incumplimientos" FontSize="11" Foreground="#991B1B" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Summary.TotalNonCompliantElements}" FontSize="18" FontWeight="Bold" Foreground="#DC2626"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="6" Padding="16,6" BorderBrush="#CBD5E1" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cumplimiento Global: " FontSize="13" Foreground="#475569" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Summary.GlobalCompliancePercentage, StringFormat='{}{0}%'}" FontSize="20" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. MAIN CONTENT: ORGANIZED TABS -->
        <TabControl Grid.Row="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1">
            
            <!-- PESTAÑA 1: REGLAS (Carga, Edición y Gestión completa) -->
            <TabItem Header="⚙️ Reglas" Foreground="#0F172A" FontSize="13" Padding="14,7">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <!-- Top Toolbar of Rules -->
                        <RowDefinition Height="Auto"/>
                        <!-- Rules DataGrid -->
                        <RowDefinition Height="*"/>
                        <!-- Simple Rule Editor -->
                        <RowDefinition Height="Auto"/>
                        <!-- Bottom Execution Bar -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Action Bar inside Reglas -->
                    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="6" Padding="10" Margin="0,0,0,10" BorderBrush="#CBD5E1" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="➕ Cargar 1 Regla (.md)" Command="{Binding LoadSingleRuleCommand}" Style="{StaticResource HeaderButtonStyle}"/>
                                <Button Content="📂 Cargar Revisión (.md)" Command="{Binding LoadRulesCommand}" Style="{StaticResource HeaderButtonStyle}"/>
                                <Button Content="💾 Guardar Reglas (.md)" Command="{Binding SaveRulesCommand}" Style="{StaticResource HeaderButtonStyle}"/>
                                <Button Content="📥 Plantilla" Command="{Binding DownloadTemplateCommand}" Style="{StaticResource HeaderButtonStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Content="➕ Nueva Regla" Command="{Binding AddRuleCommand}" Style="{StaticResource HeaderButtonStyle}"/>
                                <Button Content="🗑️ Borrar Regla" Command="{Binding DeleteRuleCommand}" Style="{StaticResource DangerButtonStyle}"/>
                                <Button Content="🧹 Limpiar Todas" Command="{Binding ClearAllRulesCommand}" Style="{StaticResource HeaderButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Rules DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                              AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                              Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                              Foreground="#0F172A" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                              HeadersVisibility="Column" FontSize="12" RowHeight="32">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Style.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#BFDBFE"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
                                </Style.Resources>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="160"/>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="110"/>
                            <DataGridTextColumn Header="Parámetro" Binding="{Binding ParameterName}" Width="110"/>
                            <DataGridTextColumn Header="Operador" Binding="{Binding Operator}" Width="100"/>
                            <DataGridTextColumn Header="Severidad" Binding="{Binding Severity}" Width="85"/>
                            <DataGridTemplateColumn Header="Color" Width="150" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableColors, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValue="{Binding HexColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="HexColor"
                                                  Margin="2" Padding="4,2" FontSize="11" Style="{StaticResource EditorComboBoxStyle}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{Binding HexColor}" CornerRadius="3" Width="16" Height="14" Margin="0,0,6,0" BorderBrush="#94A3B8" BorderThickness="1"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#0F172A"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Activa" Width="65" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Editor de Regla (Edición de la Regla Seleccionada con Categorías y Parámetros dinámicos del modelo) -->
                    <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="6" Padding="12" Margin="0,10,0,10" BorderBrush="#CBD5E1" BorderThickness="1"
                            DataContext="{Binding SelectedRule}" Visibility="{Binding SelectedRule, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="✏️ Editor de Regla" FontSize="14" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,8"/>

                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="ID Regla:" VerticalAlignment="Center" FontSize="11" Foreground="#475569"/>
                                <TextBox Grid.Column="1" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorTextBoxStyle}" Margin="0,0,8,0"/>

                                <TextBlock Grid.Column="2" Text="Categoría:" VerticalAlignment="Center" FontSize="11" Foreground="#475569"/>
                                <ComboBox Grid.Column="3" ItemsSource="{Binding DataContext.AvailableCategories, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" Style="{StaticResource EditorComboBoxStyle}" Margin="0,0,8,0"/>

                                <TextBlock Grid.Column="4" Text="Parámetro:" VerticalAlignment="Center" FontSize="11" Foreground="#475569"/>
                                <ComboBox Grid.Column="5" ItemsSource="{Binding DataContext.AvailableParameters, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding ParameterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" Style="{StaticResource EditorComboBoxStyle}" Margin="0,0,8,0"/>

                                <TextBlock Grid.Column="6" Text="Operador:" VerticalAlignment="Center" FontSize="11" Foreground="#475569"/>
                                <ComboBox Grid.Column="7" ItemsSource="{Binding DataContext.AvailableOperators, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Operator}" Style="{StaticResource EditorComboBoxStyle}"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Nombre:" VerticalAlignment="Center" FontSize="11" Foreground="#475569"/>
                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorTextBoxStyle}" Margin="0,0,8,0"/>

                                <TextBlock Grid.Column="2" Text="Valor:" VerticalAlignment="Center" FontSize="11" Foreground="#475569"/>
                                <TextBox Grid.Column="3" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorTextBoxStyle}" Margin="0,0,8,0"/>

                                <TextBlock Grid.Column="4" Text="Severidad:" VerticalAlignment="Center" FontSize="11" Foreground="#475569"/>
                                <ComboBox Grid.Column="5" ItemsSource="{Binding DataContext.AvailableSeverities, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Severity}" Style="{StaticResource EditorComboBoxStyle}" Margin="0,0,8,0"/>

                                <TextBlock Grid.Column="6" Text="Color:" VerticalAlignment="Center" FontSize="11" Foreground="#475569"/>
                                <ComboBox Grid.Column="7" ItemsSource="{Binding DataContext.AvailableColors, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding DataContext.SelectedColorOption, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Style="{StaticResource EditorComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{Binding HexColor}" Width="16" Height="14" CornerRadius="3" Margin="0,0,8,0" BorderBrush="#94A3B8" BorderThickness="1"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#0F172A"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Execution Bar at bottom of Reglas Tab -->
                    <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="8" Padding="12" BorderBrush="#CBD5E1" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Generar Revisión de Calidad BIM" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Se auditarán únicamente las reglas marcadas como 'Activas' sobre los elementos de modelo visibles." FontSize="12" Foreground="#475569"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="▶️ GENERAR REVISIÓN" Command="{Binding ExecuteRulesCommand}" Style="{StaticResource PrimaryAccentButtonStyle}" Padding="24,10" FontSize="14"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- RESUMEN EJECUTIVO: diseño ligero y estable para el host WPF de Revit -->
            <TabItem Header="📈 Resumen ejecutivo" Foreground="#2563EB" FontSize="13" Padding="14,7"
                     Visibility="{Binding HasAuditResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="Resumen ejecutivo de calidad BIM" FontSize="23" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Indicadores consolidados para presentación a gerencia." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="CUMPLIMIENTO GLOBAL" FontSize="11" FontWeight="Bold" Foreground="#1E40AF"/><TextBlock Text="{Binding Summary.GlobalCompliancePercentage, StringFormat='{}{0}%'}" FontSize="30" FontWeight="Bold" Foreground="#2563EB" Margin="0,6,0,0"/></StackPanel></Border>
                        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="ELEMENTOS REVISADOS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/><TextBlock Text="{Binding Summary.TotalElementsEvaluated}" FontSize="30" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,0"/></StackPanel></Border>
                        <Border Grid.Column="2" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="CUMPLEN" FontSize="11" FontWeight="Bold" Foreground="#166534"/><TextBlock Text="{Binding Summary.TotalCompliantElements}" FontSize="30" FontWeight="Bold" Foreground="#16A34A" Margin="0,6,0,0"/></StackPanel></Border>
                        <Border Grid.Column="3" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="INCUMPLIMIENTOS" FontSize="11" FontWeight="Bold" Foreground="#991B1B"/><TextBlock Text="{Binding Summary.TotalNonCompliantElements}" FontSize="30" FontWeight="Bold" Foreground="#DC2626" Margin="0,6,0,0"/></StackPanel></Border>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,12,0">
                            <StackPanel><TextBlock Text="Prioridad gerencial" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/><TextBlock Text="Hallazgos de severidad alta" Foreground="#64748B" Margin="0,16,0,3"/><TextBlock Text="{Binding Summary.HighSeverityCount}" FontSize="34" FontWeight="Bold" Foreground="#D97706"/><TextBlock Text="Atender los incumplimientos críticos antes de la siguiente entrega del modelo." TextWrapping="Wrap" Foreground="#475569" LineHeight="20" Margin="0,18,0,0"/></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel><TextBlock Text="Siguiente acción" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/><TextBlock Text="Revise el Listado de reporte para localizar cada hallazgo. Use Exportar Excel para distribuir el resumen, el detalle y las cantidades." TextWrapping="Wrap" Foreground="#475569" LineHeight="21" Margin="0,16,0,0"/></StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="📋 Listado de reporte" Foreground="#2563EB" FontSize="13" Padding="14,7"
                     Visibility="{Binding HasAuditResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Lista consolidada de elementos evaluados. Revise el resultado y exporte el detalle, el resumen y las cantidades a Excel." Foreground="#475569" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="📗 Exportar Excel" Command="{Binding ExportExcelReportCommand}" Style="{StaticResource PrimaryAccentButtonStyle}" Margin="12,0,0,0"/>
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ReportItems}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" Foreground="#0F172A">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="ElementId" Binding="{Binding ElementId}" Width="90"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding CategoryName}" Width="130"/>
                            <DataGridTextColumn Header="Familia" Binding="{Binding FamilyName}" Width="150"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TypeName}" Width="150"/>
                            <DataGridTextColumn Header="Nivel" Binding="{Binding LevelName}" Width="120"/>
                            <DataGridTextColumn Header="Observaciones" Binding="{Binding Observations}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="📦 Cantidades" Foreground="#2563EB" FontSize="13" Padding="14,7"
                     Visibility="{Binding HasAuditResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Resumen de cantidades del modelo" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A"/>
                            <TextBlock Text="Las cantidades se actualizan al generar la revisión. El botón Dashboard de cantidades exporta el informe con gráficos de torta y barras." Margin="0,4,0,0" Foreground="#475569" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Quantities}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" Foreground="#0F172A">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding CategoryName}" Width="*"/>
                            <DataGridTextColumn Header="Elementos" Binding="{Binding ElementCount}" Width="120"/>
                            <DataGridTextColumn Header="Longitud" Binding="{Binding LengthDisplay}" Width="140"/>
                            <DataGridTextColumn Header="Área" Binding="{Binding AreaDisplay}" Width="140"/>
                            <DataGridTextColumn Header="Volumen" Binding="{Binding VolumeDisplay}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- PESTAÑAS DINÁMICAS POR CADA REGLA EJECUTADA (SOLO REGLAS EJECUTADAS) -->
            <TabItem Header="📊 Resultados de Auditoría" Foreground="#2563EB" FontSize="13" Padding="14,7"
                     Visibility="{Binding HasAuditResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TabControl ItemsSource="{Binding RuleTabs}" SelectedItem="{Binding SelectedRuleTab}"
                            Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Margin="8">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="6,2">
                                <Border Background="{Binding Rule.HexColor}" CornerRadius="3" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Rule.Id}" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Rule.Name}" Foreground="#334155"/>
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>

                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Rule Detail Banner -->
                                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#CBD5E1" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{Binding Rule.HexColor}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Rule.Id}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                                                </Border>
                                                <TextBlock Text="{Binding Rule.Name}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Rule.Description}" FontSize="12" Foreground="#475569" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#EFF6FF" CornerRadius="4" Padding="10,4" Margin="0,0,8,0" BorderBrush="#BFDBFE" BorderThickness="1">
                                                <TextBlock Text="{Binding CompliancePercentage, StringFormat='Cumplimiento: {0}%'}" FontWeight="Bold" Foreground="#1D4ED8"/>
                                            </Border>
                                            <Border Background="#F1F5F9" CornerRadius="4" Padding="8,4" BorderBrush="#CBD5E1" BorderThickness="1">
                                                <TextBlock Text="{Binding Rule.Severity, StringFormat='Severidad: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Filters & Revit Actions Bar -->
                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Filters -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Filtrar:" FontSize="12" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="{Binding TotalEvaluated, StringFormat='Todos ({0})'}" Command="{Binding SetFilterTodosCommand}" Style="{StaticResource FilterButtonStyle}"/>
                                        <Button Content="{Binding CompliantCount, StringFormat='✓ Cumplen ({0})'}" Command="{Binding SetFilterCumplenCommand}" Style="{StaticResource FilterButtonStyle}"/>
                                        <Button Content="{Binding NonCompliantCount, StringFormat='❌ No cumplen ({0})'}" Command="{Binding SetFilterNoCumplenCommand}" Style="{StaticResource FilterButtonStyle}"/>
                                    </StackPanel>

                                    <!-- Revit Actions -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="🎯 Seleccionar en Revit" Command="{Binding SelectInRevitCommand}" Style="{StaticResource RevitActionButtonStyle}"/>
                                        <Button Content="👁️ Aislar Seleccionados" Command="{Binding IsolateInRevitCommand}" Style="{StaticResource RevitActionButtonStyle}"/>
                                        <Button Content="🎨 Resaltar Seleccionados" Command="{Binding HighlightInRevitCommand}" Style="{StaticResource RevitActionButtonStyle}"/>
                                        <Button Content="🚫 Aislar Incumplimientos" Command="{Binding IsolateNonCompliantCommand}" Style="{StaticResource RevitActionButtonStyle}"/>
                                        <Button Content="🚨 Resaltar Incumplimientos" Command="{Binding HighlightNonCompliantCommand}" Style="{StaticResource RevitActionButtonStyle}"/>
                                        <Button Content="↩️ Restaurar Vista" Command="{Binding RestoreViewCommand}" Style="{StaticResource HeaderButtonStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Results DataGrid -->
                                <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredElements}" SelectedItem="{Binding SelectedElement}"
                                          SelectionChanged="ResultsDataGrid_SelectionChanged" SelectionMode="Extended"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                                          Foreground="#0F172A" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                          HeadersVisibility="Column" RowHeight="32">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#E2E8F0"/>
                                            <Setter Property="Foreground" Value="#0F172A"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Padding" Value="10,6"/>
                                        </Style>
                                        <Style TargetType="DataGridRow">
                                            <Style.Resources>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#BFDBFE"/>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
                                            </Style.Resources>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Estado" Width="75">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="✓ OK"/>
                                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Complies}" Value="False">
                                                                        <Setter Property="Text" Value="❌ Error"/>
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="ElementId" Binding="{Binding ElementId}" Width="90"/>
                                        <DataGridTextColumn Header="Categoría" Binding="{Binding CategoryName}" Width="120"/>
                                        <DataGridTextColumn Header="Familia" Binding="{Binding FamilyName}" Width="160"/>
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding TypeName}" Width="160"/>
                                        <DataGridTextColumn Header="Nivel" Binding="{Binding LevelName}" Width="110"/>
                                        <DataGridTextColumn Header="Valor Encontrado" Binding="{Binding ValueFound}" Width="140"/>
                                        <DataGridTextColumn Header="Observación" Binding="{Binding Violations[0].Observation}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </TabItem>

        </TabControl>

        <!-- 3. STATUS BAR -->
        <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="4" Padding="10,6" Margin="0,10,0,0" BorderBrush="#CBD5E1" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding State, StringFormat='Estado: {0}'}" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/>
            </Grid>
        </Border>
    </Grid>
</Window>
