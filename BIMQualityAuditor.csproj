<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <RevitInstallDir Condition="'$(RevitVersion)' == '2025'">C:\Program Files\Autodesk\Revit 2025</RevitInstallDir>
    <RevitInstallDir Condition="'$(RevitVersion)' == '2027'">C:\Program Files\Autodesk\Revit 2027</RevitInstallDir>
    <TargetFramework Condition="'$(RevitVersion)' == '2025'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>
    <BaseOutputPath Condition="'$(RevitVersion)' == '2027'">bin\Revit2027\</BaseOutputPath>
    <DefineConstants Condition="'$(RevitVersion)' == '2027'">$(DefineConstants);REVIT2027</DefineConstants>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <AssemblyName>BIMQualityAuditor</AssemblyName>
    <RootNamespace>BIMQualityAuditor</RootNamespace>
    <NoWarn>$(NoWarn);CS1705;MSB3277</NoWarn>
    <!-- Distribution folders contain complete copies for other Revit versions;
         they are release artifacts, not part of this project's compilation. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);scratch\**;dist\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="ico.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="ico_black.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="AudiBIM.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="AudiBIM.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="AudiBIM_16.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="AudiBIM_32.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
